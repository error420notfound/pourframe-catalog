{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PourFrame roastery index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "roastery", "coffees"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "roastery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "country": { "type": "string", "maxLength": 80 },
        "website": { "type": "string", "format": "uri" }
      }
    },
    "coffees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "path", "updatedAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "status": { "enum": ["available", "seasonal", "archived", "unknown"] },
          "path": { "type": "string", "pattern": "^roasteries/[a-z0-9-]+/coffees/[a-z0-9-]+\\.json$" },
          "updatedAt": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
